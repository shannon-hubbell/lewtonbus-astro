---
import { contentfulClient } from "../../lib/contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import { richTextOptions } from "../../lib/richTextOptions";
import Layout from "../../layouts/Layout.astro";
import type { Article } from "../../lib/contentful";

type HeaderImage = {
  fields?: {
    file?: {
      url?: string;
    };
  };
};
type Author = {
  name?: string;
  fields?: {
    name?: string;
  };
};

interface Props {
  articleContent: string;
  title: string;
  description?: string;
  date: string;
  authors?: Author[];
  headerImage?: HeaderImage;
}

export async function getStaticPaths() {
  const entries = await contentfulClient.getEntries<Article>({
    content_type: "article",
  });

  const pages = entries.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: {
      title: item.fields.title,
      description: item.fields.description,
      headerImage: item.fields.headerImage as HeaderImage | undefined,
      articleContent: documentToHtmlString(
        item.fields.articleContent,
        richTextOptions,
      ),
      date: new Date(item.fields.publicationDate).toLocaleDateString(),
      authors: item.fields.authors as unknown as
        | Array<{
            name?: string;
            fields?: { name?: string };
          }>
        | undefined,
    },
  }));
  return pages;
}

const { articleContent, title, description, date, authors, headerImage } =
  Astro.props;
---

<Layout pageTitle={title} authors={authors}>
  <div>
    <article>
      <header>
        <div class="article-banner">
          {
            headerImage?.fields?.file?.url && (
              <img src={headerImage.fields.file.url} alt={title} />
            )
          }
        </div>
        <div class="inner">
          <h1>{title}</h1>
          <p class="byline">
            By:{" "}
            {
              authors
                ?.map((author) => author.name ?? author.fields?.name ?? "")
                .join(", ") ?? ""
            }
          </p>
          <h2>{description}</h2>
        </div>
      </header>
      <div class="content" set:html={articleContent} />
    </article>
  </div>

  <style>
    article {
      header {
        display: grid;
        grid-template-columns: 38% 1fr;
        background: #fff;
        .article-banner {
          width: 100%;
          overflow: hidden;
          position: relative;
          img {
            width: 100%;
            height: 100%;
            position: absolute;
            left: 0;
            top: 0;
            object-fit: cover;
          }
        }
        h1 {
          font-size: 3rem;
          background: var(--color-text);
          color: var(--color-background);
          margin: 0;
          padding: 1rem;
          text-transform: uppercase;
        }
        h2 {
          margin: 0;
          background: var(--color-text);
          color: #fff;
          padding: 1rem;
          font-weight: 400;
          font-size: 1.3rem;
        }
        p.byline {
          padding: 1rem;
          margin: 0;
          line-height: 120%;
          text-transform: uppercase;
          font-size: 1.5rem;
        }
        @media screen and (max-width: 1200px) {
          display: block;
          .article-banner {
            aspect-ratio: 16/9;
          }
        }
      }
      .content {
        font-size: 1.2rem;
        p {
          line-height: 1.5rem;
        }
      }
    }
  </style>
</Layout>

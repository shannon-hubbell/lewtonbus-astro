---
import { contentfulClient } from "../../lib/contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import { richTextOptions } from "../../lib/richTextOptions";
import Layout from "../../layouts/Layout.astro";
import type { Article } from "../../lib/contentful";

export async function getStaticPaths() {
  const entries = await contentfulClient.getEntries<Article>({
    content_type: "article",
  });

  const pages = entries.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: {
      title: item.fields.title,
      articleContent: documentToHtmlString(item.fields.articleContent, richTextOptions),
      date: new Date(item.fields.publicationDate).toLocaleDateString(),
      authors: item.fields.authors as unknown as
			| Array<{
					name?: string;
					fields?: { name?: string };
			  }>
			| undefined,
    },
  }));
  return pages;
}

const { articleContent, title, date, authors } = Astro.props;


---

<Layout pageTitle={title} authors={authors}>
  <h1>{title}</h1>
  <time>{date}</time>
  <article set:html={articleContent} />
</Layout>

---
import { contentfulClient } from "../lib/contentful";
import type { Article } from "../lib/contentful";
import Layout from "../layouts/Layout.astro";
import HomeFeed from "../components/HomeFeed.astro";
import HomeFeatured from "../components/HomeFeatured.astro";

const entries = await contentfulClient.getEntries<Article>({
	content_type: "article",
	order: ["-fields.publicationDate"]
});

const posts = entries.items.map((item) => {
	const { title, headerImage, slug, authors, description, publicationDate } =
		item.fields;
	return {
		title,
		headerImage,
		slug,
		description,
		authors: authors as unknown as
			| Array<{
					name?: string;
					fields?: { name?: string };
			  }>
			| undefined,
		publicationDate: new Date(publicationDate).toLocaleDateString(),
	};
});

const title = "Lewton Bus";
const description = "Back and ready to brawl.";
---

<Layout pageTitle={title} pageDescription={description}>
	<div id="home-wrapper">
		<HomeFeed posts={posts} />
		<HomeFeatured posts={posts} />
	</div>
</Layout>

<style>
	#home-wrapper {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		section {
			width: 49%;
		}
		@media screen and (max-width: 700px) {
			flex-direction: column-reverse;
			section {
				width: auto;
			}
		}
	}
</style>
---
interface Props {
  frontmatter?: {
    title?: string;
    description?: string;
  };
  pageTitle?: string;
  pageDescription?: string;
}


const { frontmatter } = Astro.props;

const title = frontmatter?.title ?? Astro.props.pageTitle ?? "Shannon Ellery Hubbell";
const description = frontmatter?.description ?? Astro.props.pageDescription ?? "I build things for the internet, I write, and I am more enthusiastic about paleontology than a non-paleontologist adult should be.";

---
<!doctype html>
<html lang="en">
	<head>
		<meta name="description" content={description} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<h1>{title}</h1>
		</header>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

---
interface Props {
	frontmatter?: {
		title?: string;
		description?: string;
	};
	pageTitle?: string;
	pageDescription?: string;
}

import "../styles/general.css";

import Header from "../components/Header.astro";

const { frontmatter } = Astro.props;

const title =
	frontmatter?.title ?? Astro.props.pageTitle ?? "Shannon Ellery Hubbell";
const description =
	frontmatter?.description ??
	Astro.props.pageDescription ??
	"I build things for the internet, I write, and I am more enthusiastic about paleontology than a non-paleontologist adult should be.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta name="description" content={description} />
		<meta charset="utf-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&family=Space+Grotesk:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Header title={title} />
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
